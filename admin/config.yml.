backend:
  name: github
  repo: denishorhedenis-spec/tatiana-salon
  branch: main
  auth_scope: repo

media_folder: "assets/images"
public_folder: "/assets/images"

collections:
  - name: "news"
    label: "Новости салона"
    folder: "_data/news"
    create: true
    slug: "{{year}}-{{month}}-{{day}}-{{slug}}"
    fields:
      - {label: "Заголовок", name: "title", widget: "string"}
      - {label: "Дата", name: "date", widget: "datetime"}
      - {label: "Текст новости", name: "body", widget: "markdown"}
